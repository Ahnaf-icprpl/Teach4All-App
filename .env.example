# Application Environment Configuration
# Valid values: 'production' | 'development'
ENV=development

# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-placeholder-key-replace-with-your-actual-key

# Model Configuration
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/teach4all

# Redis Configuration (High-Volume Rate Limiting & Ephemeral State)
REDIS_URL=redis://default:your-redis-password@your-redis-host:6379

# Grafana Cloud OTLP Logging Configuration
GRAFANA_INSTANCE_ID=1828340
GRAFANA_API_KEY=placeholder_grafana_api_token_replace_with_your_actual_token
GRAFANA_OTLP_URL=https://otlp-gateway-prod-ap-southeast-2.grafana.net/otlp/v1/logs

# Grafana Cloud OTLP Metrics Configuration
GRAFANA_METRICS_INSTANCE_ID=1828340
GRAFANA_METRICS_API_KEY=placeholder_grafana_metrics_token_replace_with_your_actual_token
GRAFANA_METRICS_URL=https://otlp-gateway-prod-ap-southeast-2.grafana.net/otlp/v1/metrics

