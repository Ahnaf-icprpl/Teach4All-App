# Application Environment Configuration
# Valid values: 'production' | 'staging' | 'development'
ENV=development

# Server Port (Optional, defaults to 3000)
PORT=3000

# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-placeholder-key-replace-with-your-actual-key

# Model Configuration
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/teach4all

# Clerk Authentication Configuration
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_FRONTEND_API=https://your-app.clerk.accounts.dev
CLERK_ACCOUNTS_URL=https://your-app.accounts.dev

# OpenTelemetry Observability (Grafana Cloud OTLP: Traces, Metrics & Loki Logs) (Optional)
# Telemetry (Traces, Metrics, and Logs) is automatically exported via OTLP to Grafana Cloud.
# Paste your Grafana Cloud Access Policy Token (glc_...)
GRAFANA_OTEL_API_KEY=glc_your_grafana_cloud_otel_token_here
OTEL_SERVICE_NAME=teach4all
LOG_LEVEL=info
# Optional explicit overrides:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-southeast-2.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64_instance_and_token>

