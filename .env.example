# Application Environment Configuration
# Valid values: 'production' | 'development'
ENV=development

# Server Port (Optional, defaults to 3000)
PORT=3000

# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-placeholder-key-replace-with-your-actual-key

# Model Configuration
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/teach4all

# Clerk Authentication Configuration
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_FRONTEND_API=https://your-app.clerk.accounts.dev
CLERK_ACCOUNTS_URL=https://your-app.accounts.dev

# Prometheus Metrics Scrape Authentication (Optional)
# Supports Bearer Token or HTTP Basic Auth
PROMETHEUS_METRICS_TOKEN=your_secure_metrics_bearer_token
METRICS_USER=prometheus
METRICS_PASSWORD=your_secure_metrics_password
