{
  "name": "teach4all",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A lightweight, offline-first learning chat built with VanJS.",
  "scripts": {
    "dev": "node --watch --watch-path=server --watch-path=.env --import ./server/instrumentation.js server/dev.js",
    "build": "npm run check && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node --test tests/router.test.mjs tests/rateLimiter.test.mjs",
    "test:e2e": "playwright test",
    "start": "node --import ./server/instrumentation.js server/index.js",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "vanjs-core": "1.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
