{
  "name": "teach4all",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A lightweight, offline-first learning chat built with VanJS.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node --test tests/router.test.mjs tests/redis.test.mjs",
    "test:e2e": "playwright test",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "vanjs-core": "1.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
